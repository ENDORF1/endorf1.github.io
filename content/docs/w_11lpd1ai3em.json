ragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"直接引燃布---此时钢铁墙的温度不够，无法烧开水"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"直接引燃木头--烧开水时间太长，玩家自己熄灭"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"直接烧铁墙--温度不够，无法烧开水"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"点燃布，布引燃木头--此时钢铁墙温度够，引燃可燃物，灶台开"}]}]}]},{"type":"figure","attrs":{"src":"https://cdn.jsdelivr.net/gh/ENDORF1/endorf1.github.io@main/images/1789485482673-cg5dp.jpg","alt":"","caption":"","width":null,"align":"center","naturalWidth":null,"naturalHeight":null}},{"type":"heading","attrs":{"textAlign":"center","indent":0,"level":3},"content":[{"type":"text","text":"第三关"}]},{"type":"paragraph","attrs":{"textAlign":"center","indent":0},"content":[{"type":"text","text":"第三关的设计旨在糅合第一关和第二关的机制，作为游戏玩法的收尾。"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"热量的传递（穿墙）"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"房梁的机制"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"热量的规划"}]}]}]},{"type":"figure","attrs":{"src":"https://cdn.jsdelivr.net/gh/ENDORF1/endorf1.github.io@main/images/1789485524496-4c44v.jpg","alt":"","caption":"","width":null,"align":"center","naturalWidth":null,"naturalHeight":null}},{"type":"heading","attrs":{"textAlign":"center","indent":0,"level":3},"content":[{"type":"text","text":"第四关"}]},{"type":"paragraph","attrs":{"textAlign":"center","indent":0},"content":[{"type":"text","text":"享受演出吧朋友！"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"第四关的设计旨在视觉效果。通过“放烟花”的演出给游戏留下尾声。"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"在烟花结束之后将跳转到标题界面，并改标题为谢谢字样，给玩家留一个彩蛋。"}]}]}]},{"type":"figure","attrs":{"src":"https://cdn.jsdelivr.net/gh/ENDORF1/endorf1.github.io@main/images/1789485767840-wg5x4.jpg","alt":"","caption":"","width":null,"align":"center","naturalWidth":null,"naturalHeight":null}},{"type":"figure","attrs":{"src":"https://cdn.jsdelivr.net/gh/ENDORF1/endorf1.github.io@main/images/1789485791020-2xjor.jpg","alt":"","caption":"","width":null,"align":"center","naturalWidth":null,"naturalHeight":null}},{"type":"heading","attrs":{"textAlign":"center","indent":0,"level":2},"content":[{"type":"text","text":"六、操作方式"}]},{"type":"table","content":[{"type":"tableRow","content":[{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null,"background":null},"content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"操作"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null,"background":null},"content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"方式"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null,"background":null},"content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"说明"}]}]}]},{"type":"tableRow","content":[{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":"center","background":null},"content":[{"type":"paragraph","attrs":{"textAlign":"center","indent":0},"content":[{"type":"text","text":"移动"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":"center","background":null},"content":[{"type":"paragraph","attrs":{"textAlign":"center","indent":0},"content":[{"type":"text","text":"WASD / 方向键"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":"center","background":null},"content":[{"type":"paragraph","attrs":{"textAlign":"center","indent":0},"content":[{"type":"text","text":"在场景中行走，持续消耗燃料"}]}]}]},{"type":"tableRow","content":[{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":"center","background":null},"content":[{"type":"paragraph","attrs":{"textAlign":"center","indent":0},"content":[{"type":"text","text":"引燃"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":"center","background":null},"content":[{"type":"paragraph","attrs":{"textAlign":"center","indent":0},"content":[{"type":"text","text":"贴近物体"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":"center","background":null},"content":[{"type":"paragraph","attrs":{"textAlign":"center","indent":0},"content":[{"type":"text","text":"玩家触碰可燃物时自动开始传递热量，离开则热量缓慢衰减"}]}]}]},{"type":"tableRow","content":[{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":"center","background":null},"content":[{"type":"paragraph","attrs":{"textAlign":"center","indent":0},"content":[{"type":"text","text":"观察"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":"center","background":null},"content":[{"type":"paragraph","attrs":{"textAlign":"center","indent":0},"content":[{"type":"text","text":"鼠标悬浮"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":"center","background":null},"content":[{"type":"paragraph","attrs":{"textAlign":"center","indent":0},"content":[{"type":"text","text":"显示物体的材质和大致含量（“木质/较多”、“钢铁/少量”）"}]}]}]}]},{"type":"paragraph","attrs":{"textAlign":"center","indent":0},"content":[{"type":"text","text":"引燃交互细节："}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"玩家靠近可燃物，热量开始从玩家传递到物体"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"物体被引燃后，进入燃烧状态，产生光照"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"光照范围内的可燃物自动获得热量，可能被连锁引燃"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"物体燃烧完毕后，木质/布质会烧毁，钢铁会烧红但不消失"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"玩家离开，热量积累暂停并缓慢衰减"}]}]}]},{"type":"heading","attrs":{"textAlign":"center","indent":0,"level":2},"content":[{"type":"text","text":"七、视觉风格"}]},{"type":"paragraph","attrs":{"textAlign":"center","indent":0},"content":[{"type":"text","text":"视角： 2D俯视"}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"色调： 几乎全黑。唯一的光来自玩家自身和正在燃烧的物体。"}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"玩家形象： 一团橙红色光点，周围有火星粒子。燃料越低，光点越小、越暗、闪烁越频繁。燃料见底时几乎是一团微弱的暗红色，间歇性明灭。"}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"场景： 焦黑的废墟轮廓，墙壁和障碍物用简单的几何形状表示。未燃烧时几乎不可见（只有极暗的轮廓），被火光照亮时才显现细节。"}]},{"type":"paragraph","attrs":{"textAlign":"center","indent":0},"content":[{"type":"text","text":"火焰效果："}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"燃烧的物体发出暖色光晕，照亮周围"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"连锁蔓延时，可以看到火光从一个物体传递到另一个"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"物体烧毁后，光晕消失，留下烧焦的残骸"}]}]}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"HUD： 无。玩家靠自身光芒的强弱和闪烁频率感知燃料余量。"}]},{"type":"heading","attrs":{"textAlign":"center","indent":0,"level":2},"content":[{"type":"text","text":"八、音频风格"}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"环境音： 寂静。偶有远处的噼啪声。"}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"玩家移动： 极轻的灰烬碾压声。"}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"引燃： 火焰升腾的呼的一声。"}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"连锁蔓延： 火焰传递时的细微噼啪声，越来越密。"}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"燃料见底： 心跳声逐渐清晰、变慢、变得不规律。"}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"抵达出口： 一声悠长的、类似叹息的风声。"}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"无背景音乐。"}]},{"type":"heading","attrs":{"textAlign":"center","indent":0,"level":2},"content":[{"type":"text","text":"九、结局"}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"玩家抵达出口——前门。门外不是黑暗，而是一片翻涌的、明亮的、活着的火焰。"}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"画面："}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"屏幕边缘被大片暖橙色光晕占据"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"那片大火在跳动、在呼吸、在等待"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"它不需要燃烧任何东西。它就是火本身。"}]}]}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"玩家动作："}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"玩家（那团微弱的、几乎要熄灭的小火）走到门口"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"停顿了一瞬间——像孩子在跳进水池前深吸一口气"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"然后，轻轻一跃，跳入那片大火之中"}]}]}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"瞬间："}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"玩家的火光和大火融为一体，再也分不清彼此"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"没有消失。没有熄灭。只是回家了。"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"屏幕渐亮，从黑暗变为温暖的橙黄色"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"一声满足的、细小的噼啪声。像是叹息。像是终于到家了。"}]}]}]},{"type":"heading","attrs":{"textAlign":"center","indent":0,"level":3},"content":[{"type":"text","text":"小小牢骚"}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"       有了想法便是招兵买马。好在组队的过程还算顺风顺水。  在小红书发了个帖子，很快就有着循声而来的程序和美术。确定了核心玩法之后，我们便开始热火朝天地做了起来，直到发生了很多不愉快的事情。"},{"type":"hardBreak"},{"type":"text","text":"      美术根本不会做2D动画，也不会使用引擎。我们提出了美术需求，却没有得到任何有效的游戏资产，就连我们游戏的封面都是我自己画的。"},{"type":"hardBreak"},{"type":"text","text":"      程序的确很有能力，然而态度却有很大的问题。他始终不认为这是我们的游戏，直到最后都认为是我们两位策划求他帮忙一起做游戏。然而事实上后续的维护、跑测、关卡搭建都是我们两位策划用AI一点一点搭起来的。"},{"type":"hardBreak"},{"type":"text","text":"     线上组队的效率的确没得说，然而在挑选共事者这方面，我得到的最大的教训是需要严格把关，宁缺毋滥。"}]},{"type":"heading","attrs":{"textAlign":"center","indent":0,"level":3},"content":[{"type":"text","text":"一点教训"}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"   有位名策划曾经说过，真正考验你能力的不是增加需求，而是在恰当的时候削减需求。这次gamejam倒是真的给了我这样的经历。"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"我们原本打算制作一个结束动画，最终因为美术没有这方面能力，没有实现。"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"我们原本打算制作二层的场景，让房梁能够塌陷下来填补一层的空洞，最终还是只制作了木门取代此功能。"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"text","text":"我们原本打算自己绘制主角的动作动画，然后美术无法绘制出中心点恒定的待机动画，最终使用了线上的像素素材。"}]}]}]},{"type":"paragraph","attrs":{"textAlign":null,"indent":0},"content":[{"type":"hardBreak"},{"type":"text","text":"        除此以外的是发布于gamejam上得到的玩家反馈。有的玩家认为引导太弱，完全不知道在玩什么。这也是解密游戏的永恒难题：给的太多，谜题本身就不够有趣，给的太少，玩家会失去方向。如果要进一步打磨游戏，我认为会在提示上下更多功夫，除了显式的文字对白，也许还可以制作场景上的提示，比如单向路径让玩家无处可选等等，奈何时间实在是不太多..."},{"type":"hardBreak"},{"type":"text","text":"       最后一点，有些玩家提出最好让游戏支持web显示，做到进入网站即开即玩----这倒是非常重要的启示。想要让更多人点开游戏，直观是必要的。我也学到了如何导出为web包并让浏览器渲染的知识。真是有趣。"}]}]}}
